{
  "name": "@ironpermjs/analyzer",
  "version": "0.1.0",
  "description": "TypeScript AST-based static authorization analysis for IronPermJS",
  "keywords": [
    "authorization",
    "casl",
    "static-analysis",
    "typescript"
  ],
  "homepage": "https://github.com/BlackProgrammer-prog/IronPermJS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackProgrammer-prog/IronPermJS.git",
    "directory": "packages/analyzer"
  },
  "bugs": {
    "url": "https://github.com/BlackProgrammer-prog/IronPermJS/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ironpermjs/core": "workspace:*",
    "typescript": "5.9.3"
  }
}
