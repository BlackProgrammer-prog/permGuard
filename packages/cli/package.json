{
  "name": "@permguard/cli",
  "version": "0.1.0",
  "description": "Command-line orchestration for PermGuard authorization analysis",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "permguard": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@permguard/analyzer": "workspace:*",
    "@permguard/core": "workspace:*",
    "@permguard/graph": "workspace:*"
  }
}
