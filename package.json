{
  "name": "permguard",
  "version": "0.0.0",
  "private": true,
  "description": "Authorization integration and analysis tooling built around CASL",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm --filter @permguard/core build && pnpm --filter @permguard/server build && pnpm --filter @permguard/react build && pnpm --filter @permguard/next build && pnpm --filter @permguard/analyzer build && pnpm --filter @permguard/graph build && pnpm --filter @permguard/diff build && pnpm --filter @permguard/reporter build && pnpm --filter @permguard/cli build",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "permguard": "node packages/cli/dist/bin.js",
    "release:dry-run": "pnpm check && node scripts/release-packages.mjs dry-run",
    "release:pack": "pnpm build && node scripts/release-packages.mjs pack",
    "release:publish": "pnpm check && node scripts/release-packages.mjs publish",
    "release:smoke": "pnpm release:verify && node scripts/smoke-packed-packages.mjs",
    "release:verify": "pnpm build && node scripts/release-packages.mjs verify",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc -p examples/next-basic/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "jsdom": "30.0.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  }
}
